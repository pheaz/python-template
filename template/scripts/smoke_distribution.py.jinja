from __future__ import annotations

import os
import subprocess
import sys
import tempfile
from pathlib import Path

PROJECT_NAME = "[[ project_name ]]"
PACKAGE_NAME = "[[ package_name ]]"


def main() -> None:
    wheels = sorted(Path("dist").glob("*.whl"))

    if len(wheels) != 1:
        raise RuntimeError(
            f"Expected exactly one wheel, found {len(wheels)}"
        )

    wheel = wheels[0].resolve()

    with tempfile.TemporaryDirectory() as temporary_directory:
        environment = Path(temporary_directory) / "smoke"

        _ = subprocess.run(
            [
                "uv",
                "venv",
                str(environment),
                "--python",
                sys.executable,
            ],
            check=True,
        )

        if os.name == "nt":
            python = environment / "Scripts" / "python.exe"
            executable = (
                environment
                / "Scripts"
                / f"{PROJECT_NAME}.exe"
            )
        else:
            python = environment / "bin" / "python"
            executable = environment / "bin" / PROJECT_NAME

        _ = subprocess.run(
            [
                "uv",
                "pip",
                "install",
                "--python",
                str(python),
                str(wheel),
            ],
            check=True,
        )

        _ = subprocess.run(
            [
                str(python),
                "-m",
                PACKAGE_NAME,
                "--help",
            ],
            check=True,
        )

        _ = subprocess.run(
            [
                str(executable),
                "--help",
            ],
            check=True,
        )


if __name__ == "__main__":
    main()
