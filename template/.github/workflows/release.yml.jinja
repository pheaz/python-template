name: Publish release to PyPI

on:
  push:
    tags:
      - "v*"

jobs:
  build:
    name: Build distributions
    runs-on: ubuntu-latest

    permissions:
      contents: read

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: false

      - run: uv sync --locked --group dev

      - name: Verify release tag
        shell: bash
        run: |
          package_version="$(
            uv run --locked --no-sync python -c \
              'from importlib.metadata import version; print(version("[[ project_name ]]"))'
          )"

          expected_tag="v${package_version}"

          if [[ "${GITHUB_REF_NAME}" != "${expected_tag}" ]]; then
            echo "Tag ${GITHUB_REF_NAME} does not match ${expected_tag}." >&2
            false
          fi

      - name: Quality
        run: |
          uv run --locked --no-sync nox \
            -s format \
            -s lint \
            -s typecheck \
            -s spec \
            -s tests \
            -s lock

      - run: uv build --no-sources

      - run: uv run --locked --no-sync python scripts/smoke_distribution.py

      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: dist
          path: dist/

  publish:
    name: Publish to PyPI
    needs: build
    runs-on: ubuntu-latest

    environment:
      name: pypi
      url: https://pypi.org/p/[[ project_name ]]

    permissions:
      id-token: write

    steps:
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: false

      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: dist
          path: dist/

      - run: uv publish
