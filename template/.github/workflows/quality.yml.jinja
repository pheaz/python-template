name: Quality

on:
  push:
    branches:
      - main
  pull_request:

permissions:
  contents: read

concurrency:
  group: quality-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
[% if repository_visibility == "private" %]
  quota:
    name: Actions quota
    runs-on: ubuntu-latest

    outputs:
      usage_available: ${{ steps.quota.outputs.usage_available }}
      usage_percent: ${{ steps.quota.outputs.usage_percent }}

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: true

      - id: quota
        env:
          ACTIONS_QUOTA_TOKEN: ${{ secrets.ACTIONS_QUOTA_TOKEN }}
          ACTIONS_QUOTA_MINUTES: ${{ vars.ACTIONS_QUOTA_MINUTES || '2000' }}
        run: uv run --locked --group ci github-actions-quota
[% endif %]

  lock:
    name: Lock
[% if repository_visibility == "private" %]
    needs: quota
    if: >-
      needs.quota.outputs.usage_available == 'true' &&
      needs.quota.outputs.usage_percent < 100
[% endif %]
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"

      - run: uv lock --check

  format:
    name: Format
[% if repository_visibility == "private" %]
    needs: quota
    if: >-
      needs.quota.outputs.usage_available == 'true' &&
      needs.quota.outputs.usage_percent < 50
[% endif %]
    runs-on: [% if platform == "windows" %]windows-latest[% elif platform == "macos" %]macos-latest[% else %]ubuntu-latest[% endif %]

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: true

      - run: uv sync --locked --group dev
      - run: uv run --locked --no-sync nox -s format

  lint:
    name: Lint
[% if repository_visibility == "private" %]
    needs: quota
    if: >-
      needs.quota.outputs.usage_available == 'true' &&
      needs.quota.outputs.usage_percent < 50
[% endif %]
    runs-on: [% if platform == "windows" %]windows-latest[% elif platform == "macos" %]macos-latest[% else %]ubuntu-latest[% endif %]

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: true

      - run: uv sync --locked --group dev
      - run: uv run --locked --no-sync nox -s lint

  typecheck:
    name: Type Check
[% if repository_visibility == "private" %]
    needs: quota
    if: >-
      needs.quota.outputs.usage_available == 'true' &&
      needs.quota.outputs.usage_percent < 50
[% endif %]
    runs-on: [% if platform == "windows" %]windows-latest[% elif platform == "macos" %]macos-latest[% else %]ubuntu-latest[% endif %]

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: true

      - run: uv sync --locked --group dev
      - run: uv run --locked --no-sync nox -s typecheck

  spec:
    name: Specification
[% if repository_visibility == "private" %]
    needs: quota
    if: >-
      needs.quota.outputs.usage_available == 'true' &&
      needs.quota.outputs.usage_percent < 50
[% endif %]
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: true

      - run: uv sync --locked --group dev
      - run: uv run --locked --no-sync nox -s spec

  tests:
    name: Tests
[% if repository_visibility == "private" %]
    needs: quota
    if: >-
      needs.quota.outputs.usage_available == 'true' &&
      needs.quota.outputs.usage_percent < 50
[% endif %]
[% if platform == "cross-platform" %]
    strategy:
      fail-fast: false
      matrix:
        os:
          - ubuntu-latest
          - windows-latest
          - macos-latest
    runs-on: ${{ matrix.os }}
[% else %]
    runs-on: [% if platform == "windows" %]windows-latest[% elif platform == "macos" %]macos-latest[% else %]ubuntu-latest[% endif %]
[% endif %]

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: true

      - run: uv sync --locked --group dev
      - run: uv run --locked --no-sync nox -s tests

  build:
    name: Build
[% if repository_visibility == "private" %]
    needs: quota
    if: >-
      needs.quota.outputs.usage_available == 'true' &&
      needs.quota.outputs.usage_percent < 50
[% endif %]
    runs-on: [% if platform == "windows" %]windows-latest[% elif platform == "macos" %]macos-latest[% else %]ubuntu-latest[% endif %]

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
        with:
          version: "0.12.19"
          enable-cache: true

      - run: uv sync --locked --group dev
      - run: uv run --locked --no-sync nox -s build
