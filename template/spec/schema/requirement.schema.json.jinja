{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "[[ project_name ]] requirement registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "statement",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[[ spec_prefix ]]-REQ-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "implemented",
              "deprecated"
            ]
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "normal",
              "low"
            ]
          }
        }
      }
    }
  }
}
