{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "[[ project_name ]] behavioral flow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "scope",
    "title",
    "status",
    "entry",
    "steps",
    "terminal_states"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[[ spec_prefix ]]-FLOW-[A-Z0-9-]+$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "product",
        "development"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "implemented",
        "deprecated"
      ]
    },
    "entry": {
      "$ref": "#/$defs/nodeId"
    },
    "requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[[ spec_prefix ]]-REQ-[A-Z0-9-]+$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[[ spec_prefix ]]-CAP-[A-Z0-9-]+$"
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/terminal"
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "transitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/nodeId"
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "transitions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "action",
            "decision"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "pattern": "^[[ spec_prefix ]]-CAP-[A-Z0-9-]+$"
        },
        "subflow": {
          "type": "string",
          "pattern": "^[[ spec_prefix ]]-FLOW-[A-Z0-9-]+$"
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[[ spec_prefix ]]-REQ-[A-Z0-9-]+$"
          }
        },
        "transitions": {
          "$ref": "#/$defs/transitions"
        }
      },
      "anyOf": [
        {
          "required": [
            "action"
          ]
        },
        {
          "required": [
            "capability"
          ]
        },
        {
          "required": [
            "subflow"
          ]
        }
      ]
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "skipped"
          ]
        },
        "capability": {
          "type": "string",
          "pattern": "^[[ spec_prefix ]]-CAP-[A-Z0-9-]+$"
        }
      }
    }
  }
}
