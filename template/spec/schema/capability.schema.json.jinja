{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "[[ project_name ]] capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "status",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[[ spec_prefix ]]-CAP-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "implemented",
              "deprecated"
            ]
          },
          "requirements": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[[ spec_prefix ]]-REQ-[A-Z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
